# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Data caches & big binaries (regenerable, large)
*.parquet
*.h5
*.pkl
market_data_cache_*.parquet
# ...but the regression-guard fixtures are committed on purpose so a clean clone /
# CI can run the offline drift guards (`python -m tools.shadow_diff --check`,
# `python -m core.archive.seed_recall --hermetic-check`,
# `python -m tools.negative_corpus --check`,
# `python -m tools.marks_corpus --check` and
# `python -m tools.cause_veto_corpus --check`) with no network.
!tests/baselines/shadow_fixture.parquet
!tests/baselines/seed_recall_fixture.parquet
!tests/baselines/negative_corpus.parquet
!tests/baselines/marks_corpus.parquet
!tests/baselines/cause_veto_corpus.parquet
# Market-data cache sidecars (regenerated by core/pipeline/data.py); the *_<universe>
# variants are the per-universe caches written by the multi-universe scans.
cache_meta.json
cache_meta_*.json
market_context.json
market_context_*.json

# Generated output — keep .py code in output/, exclude bulky generated data
output/*.json
output/*.jsonl
output/*.bak
output/*.log
output/logs/
output/*_analysis.md
*.log

# Runtime artifacts written at scan time (not source)
ticker_quarantine.json
ticker_admission.json
# Cross-process cache lock sidecars (core/pipeline/file_lock.py)
*.lock

# Generated screener / backtest CSVs — regenerated on every run, no value in git history.
output/watchlists/*.csv
output/backtest/*.csv
output/audits/

# Eyeball chart renders. The operator ruled these DO NOT COMMIT (2026-08-04);
# every family is reproducible from the price cache by a committed tool —
# `python -m tools.full_package_render <TICKERS>`, `python -m tools.trend_terminal_ab
# --sheet DIR`, `python -m tools.ar_first_reaction_diff --scan`. The ruling used to
# live as a hand-listed block in .git/info/exclude, which is machine-local: it never
# survived a clone, never protected CI, and let each new render land untracked AND
# unignored. The SHEETS beside the images (LOSSES.md / index.html / README.md /
# scan_*.txt) stay tracked — they carry the measured numbers the flag ledger cites,
# so every EC-16 pointer keeps resolving without the pixels.
tools/fidelity/**/*.png
# Regenerable L2 event-reader renders; no ruling cites an individual image.
docs/engine_pass/e1_renders_*/

# Ticker universe cache — auto-refreshed from NASDAQ FTP when stale (see core/pipeline/data.py)
config/tickers.csv

# Personal trading data — NEVER commit
*.db
*.db.pre-*
*.db.premigration.bak
*.db.prewatchlistledger.bak
*.db.precalibevents.bak
*.db-wal
*.db-shm
# A read of any .bak can mint its own sidecars — same data, same rule.
*.bak-wal
*.bak-shm
*.db.bak*
*.sqlite
*.sqlite3
trading_journal.db

# webapp frontend build artifacts
webapp/frontend/node_modules/
webapp/frontend/dist/
webapp/frontend/dist_previous/
webapp/frontend/.next/
webapp/frontend/build/

# Secrets / local config
.env
.env.local
*.key
*.pem
config/secrets.py

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code working files
.claude/

# Ultra Council run scaffolding (per-run briefs, worker files, review docs, resume
# pointers) and the vendored council toolkit + personal handoff docs. Internal
# dev-time artifacts, not product code — the durable reasoning lives in the memory
# namespace, so these do not belong in the tree.
.council/
context-handling/

# Council-plan deliverables — the PLAN-<slug>.md a council-plan run writes at the
# root for council-implement to consume. Working scaffolding once implemented;
# the surviving reasoning lives in memory, so keep these out of git history.
/PLAN-*.md

# Calibration frame store — NOT a regenerable cache (unlike the parquet caches
# above): marks bind to these frames' digests, and a post-restatement refetch
# yields DIFFERENT bytes, so deleting this directory permanently destroys the
# replay basis of the calibration corpus. Never "clean" it; back it up with
# the same habit that covers trading_journal.db.
calibration_frames/
